# Frontend-safe Supabase project settings (Expo exposes EXPO_PUBLIC_* values)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Local web: http://localhost:3000. Physical device: use your computer's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000

# Backend-only Supabase JWT signing secret. Never expose this to Expo/Vercel frontend bundles.
SUPABASE_JWT_SECRET=replace-with-the-supabase-jwt-secret